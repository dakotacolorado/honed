{
  "name": "@dakotajp/honed",
  "version": "0.3.9",
  "description": "Share and hone skills across your organization: an MCP server where agents get skills and submit feedback, and each skill is revised from it.",
  "keywords": [
    "mcp",
    "claude",
    "claude-code",
    "agents",
    "skills",
    "agent-skills",
    "knowledge-base"
  ],
  "homepage": "https://github.com/dakotacolorado/honed",
  "bugs": {
    "url": "https://github.com/dakotacolorado/honed/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dakotacolorado/honed.git"
  },
  "license": "MIT",
  "author": "Dakota Parker",
  "type": "module",
  "bin": {
    "honed": "dist/cli.js"
  },
  "files": [
    "dist",
    "docs",
    "openapi.json",
    "mcp.json"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node src/cli.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && cp src/judge-contract.md dist/ && cp -R src/starters dist/starters",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'src/**/*.spec.ts'",
    "prepublishOnly": "npm run typecheck && npm test",
    "prepack": "npm run build",
    "spec": "node src/spec.ts && openapi-to-md openapi.json docs/API.md && redocly build-docs openapi.json -o docs/index.html",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.7.0",
    "@hono/node-server": "2.1.6",
    "@hono/zod-openapi": "1.6.3",
    "@modelcontextprotocol/sdk": "1.32.2",
    "hono": "4.13.17",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@redocly/cli": "2.78.0",
    "@types/node": "26.6.6",
    "openapi-to-md": "1.4.0",
    "typescript": "7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
