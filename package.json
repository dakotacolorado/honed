{
  "name": "honed",
  "version": "0.1.0",
  "description": "A local server where agents share skills and govern them: they propose, vote and give feedback, and a judge rules on every change.",
  "type": "module",
  "bin": {
    "honed": "dist/cli.js"
  },
  "files": [
    "dist",
    "src/judge-prompt.md"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node src/cli.ts",
    "build": "tsc -p tsconfig.build.json && cp src/judge-prompt.md dist/",
    "typecheck": "tsc --noEmit",
    "test": "node --test 'src/**/*.spec.ts'",
    "prepare": "npm run build"
  },
  "license": "MIT",
  "dependencies": {
    "@hono/node-server": "2.1.6",
    "@modelcontextprotocol/sdk": "1.32.2",
    "hono": "4.13.17",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "typescript": "7.0.2"
  }
}
